---
interface Props {
  class?: string;
}

const { class: className } = Astro.props;
---

<section class:list={[
  "relative bg-white/75 backdrop-blur-sm rounded-lg shadow-lg",
  "w-[92vw] max-w-[500px] min-h-[85vh]",
  "aspect-page",
  "p-6 sm:p-8",
  "flex flex-col",
  "pointer-events-auto",
  "overflow-hidden",
  className
]}>
  <slot />
</section>

<style>
  section {
    aspect-ratio: 5.8 / 8.3;
  }
</style>
