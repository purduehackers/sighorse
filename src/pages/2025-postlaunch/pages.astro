---
import '@/styles/2025-postlaunch.css';

const COLUMNS = 20;

const pageModules = import.meta.glob('../../assets/2025-postlaunch/pages/page-*.jpg', { eager: true });
const TOTAL_PAGES = Object.keys(pageModules).length;
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Every Page — SIGHORSE 2025</title>
  <style>
    * { margin: 0; padding: 0; box-sizing: border-box; }

    html, body {
      width: 100%;
      height: 100%;
      background: #e0e0e0;
      overflow: hidden;
      font-family: "Libertinus Serif", "Linux Libertine", serif;
    }

    #viewer {
      width: 100%;
      height: 100%;
      background: #e0e0e0;
    }

    /* Loading overlay — styled like a page-card */
    #loading {
      position: fixed;
      inset: 0;
      background: rgba(224, 224, 224, 0.92);
      backdrop-filter: blur(3px);
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      z-index: 100;
      gap: 1.5rem;
      transition: opacity 0.6s ease;
    }

    #loading.fade-out {
      opacity: 0;
      pointer-events: none;
    }

    #loading-title {
      font-family: 'Iosevka Heavy Oblique', 'Iosevka Curly Hv Ex Obl', 'Inter', sans-serif;
      font-size: clamp(1.4rem, 4vw, 2.2rem);
      letter-spacing: -0.03em;
      color: #000;
    }

    #loading-bar-outer {
      width: min(400px, 80vw);
      height: 2px;
      background: rgba(0,0,0,0.15);
    }

    #loading-bar {
      height: 100%;
      width: 0%;
      background: #000;
      transition: width 0.1s linear;
    }

    #loading-count {
      font-family: "Libertinus Serif", serif;
      font-size: 0.95rem;
      color: #555;
    }

    /* Nav bar — frosted glass matching page-card texture */
    #nav {
      position: fixed;
      top: 0;
      left: 0;
      right: 0;
      display: flex;
      align-items: center;
      gap: 1rem;
      padding: 0.55rem 1.2rem;
      background: rgba(255, 255, 255, 0.75);
      backdrop-filter: blur(3px);
      border-bottom: 1px solid rgba(0,0,0,0.18);
      box-shadow: 0 2px 8px rgba(0,0,0,0.07);
      z-index: 50;
      font-family: "Libertinus Serif", serif;
      font-size: 0.9rem;
    }

    #nav-title {
      font-family: 'Iosevka Heavy Oblique', 'Iosevka Curly Hv Ex Obl', 'Inter', sans-serif;
      font-size: 1.1rem;
      letter-spacing: -0.03em;
      color: #000;
      text-decoration: none;
    }

    #nav-title:hover { opacity: 0.7; }

    #nav .sep { color: #aaa; margin: 0 0.1rem; }

    #nav a.plain-link {
      color: #000;
      text-decoration: none;
    }

    #nav a.plain-link:hover { text-decoration: underline; }

    #nav .info {
      margin-left: auto;
      color: #666;
      font-size: 0.8rem;
      font-style: italic;
    }

    /* Zoom controls */
    .osd-controls {
      position: fixed;
      bottom: 1.2rem;
      right: 1.2rem;
      display: flex;
      flex-direction: column;
      gap: 4px;
      z-index: 50;
    }

    .osd-controls button {
      width: 36px;
      height: 36px;
      background: rgba(255,255,255,0.82);
      backdrop-filter: blur(3px);
      color: #000;
      border: 1px solid rgba(0,0,0,0.2);
      box-shadow: 0 2px 6px rgba(0,0,0,0.12);
      cursor: pointer;
      font-size: 1.1rem;
      font-family: "Libertinus Serif", serif;
      display: flex;
      align-items: center;
      justify-content: center;
    }

    .osd-controls button:hover {
      background: rgba(255,255,255,0.97);
    }
  </style>
</head>
<body>
  <div id="loading">
    <div id="loading-title">SIGHORSE 2025</div>
    <div id="loading-bar-outer"><div id="loading-bar"></div></div>
    <div id="loading-count">Loading…</div>
  </div>

  <div id="nav">
    <a id="nav-title" href="/2025-postlaunch">SIGHORSE 2025</a>
    <span class="sep">|</span>
    <a href="/2025-postlaunch" class="plain-link">← back</a>
    <span class="sep">|</span>
    <a href="/2025-postlaunch/book.pdf" class="plain-link">PDF</a>
    <span class="info">308 pages · 20 per row · scroll to zoom · drag to pan</span>
  </div>

  <div id="viewer" data-columns={COLUMNS} data-total={TOTAL_PAGES}></div>

  <div class="osd-controls">
    <button id="btn-zoom-in" title="Zoom in">+</button>
    <button id="btn-home" title="Reset view">⌂</button>
    <button id="btn-zoom-out" title="Zoom out">−</button>
  </div>

  <script is:inline src="https://cdn.jsdelivr.net/npm/openseadragon@4.1/build/openseadragon/openseadragon.min.js"></script>
  <script is:inline>
    var COLUMNS = parseInt(document.getElementById('viewer').dataset.columns, 10);
    var TOTAL = parseInt(document.getElementById('viewer').dataset.total, 10);

    var PAGE_ASPECT = 1.414;
    var PAGE_W = 1;
    var PAGE_H = PAGE_W * PAGE_ASPECT;
    var GAP_X = 0.04;
    var GAP_Y = 0.05;

    var viewer = OpenSeadragon({
      id: 'viewer',
      prefixUrl: 'https://cdn.jsdelivr.net/npm/openseadragon@4.1/build/openseadragon/images/',
      showNavigationControl: false,
      showNavigator: false,
      animationTime: 0.4,
      blendTime: 0.1,
      constrainDuringPan: false,
      maxZoomPixelRatio: 4,
      minZoomImageRatio: 0.1,
      visibilityRatio: 0.05,
      zoomPerScroll: 1.3,
      gestureSettingsMouse: { clickToZoom: false },
      background: '#e0e0e0',
    });

    var loadingEl = document.getElementById('loading');
    var barEl = document.getElementById('loading-bar');
    var countEl = document.getElementById('loading-count');
    var loaded = 0;

    function onLoad() {
      loaded++;
      var pct = Math.round((loaded / TOTAL) * 100);
      barEl.style.width = pct + '%';
      countEl.textContent = loaded + ' / ' + TOTAL + ' pages';
      if (loaded === TOTAL) {
        setTimeout(function() {
          loadingEl.classList.add('fade-out');
          setTimeout(function() { loadingEl.remove(); }, 700);
        }, 200);
      }
    }

    for (var i = 0; i < TOTAL; i++) {
      var num = String(i + 1).padStart(3, '0');
      var url = '/2025-postlaunch/dzi/page-' + num + '.dzi';
      var col = i % COLUMNS;
      var row = Math.floor(i / COLUMNS);
      var x = col * (PAGE_W + GAP_X);
      var y = row * (PAGE_H + GAP_Y);

      viewer.addTiledImage({
        tileSource: url,
        x: x,
        y: y,
        width: PAGE_W,
        success: onLoad,
        error: onLoad,
      });
    }

    document.getElementById('btn-zoom-in').addEventListener('click', function() { viewer.viewport.zoomBy(1.5); });
    document.getElementById('btn-zoom-out').addEventListener('click', function() { viewer.viewport.zoomBy(1 / 1.5); });
    document.getElementById('btn-home').addEventListener('click', function() { viewer.viewport.goHome(); });
  </script>
</body>
</html>
