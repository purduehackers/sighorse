---
import { Image } from 'astro:assets';
import '@/styles/2025-postlaunch.css';
import wraparoundCover from '@/assets/2025-postlaunch/pages/page-001.jpg';

const COLUMNS = 20;

const pageModules = import.meta.glob('../../assets/2025-postlaunch/pages/page-*.jpg', { eager: true });
const TOTAL_PAGES = Object.keys(pageModules).length;
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>SIGHORSE 2025 pages</title>
  <style>
    * { margin: 0; padding: 0; box-sizing: border-box; }

    html, body {
      width: 100%;
      height: 100%;
      background: #e0e0e0;
      overflow: hidden;
      font-family: "Libertinus Serif", "Linux Libertine", serif;
    }

    #viewer {
      width: 100%;
      height: 100%;
      background: #e0e0e0;
    }

    /* Loading overlay */
    #loading {
      position: fixed;
      inset: 0;
      background: rgba(224, 224, 224, 0.92);
      backdrop-filter: blur(3px);
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      z-index: 100;
      gap: 1.5rem;
      transition: opacity 0.6s ease;
    }

    #loading.fade-out {
      opacity: 0;
      pointer-events: none;
    }

    #loading-cover {
      width: min(480px, 85vw);
      height: auto;
      box-shadow: 0 10px 30px rgba(0,0,0,0.3);
    }

    /* Windows 7-style progress bar */
    #loading-bar-outer {
      width: min(480px, 85vw);
      height: 16px;
      padding: 1px;
      border: 1px solid #8e8f8f;
      border-radius: 3px;
      background: linear-gradient(to bottom, #dcdcdc, #f3f3f3);
      box-shadow: inset 0 1px 2px rgba(0,0,0,0.15), 0 1px 0 rgba(255,255,255,0.8);
      overflow: hidden;
    }

    #loading-bar {
      position: relative;
      height: 100%;
      width: 0%;
      border-radius: 2px;
      background: linear-gradient(to bottom, #cdf6b8 0%, #7ee05c 45%, #3cc41f 50%, #4fd436 100%);
      overflow: hidden;
      transition: width 0.1s linear;
    }

    /* the light that sweeps across the filled part */
    #loading-bar::after {
      content: '';
      position: absolute;
      inset: 0;
      width: 40%;
      background: linear-gradient(to right, transparent, rgba(255,255,255,0.6), transparent);
      animation: progress-sweep 2s linear infinite;
    }

    @keyframes progress-sweep {
      from { transform: translateX(-100%); }
      to { transform: translateX(250%); }
    }

    @media (prefers-reduced-motion: reduce) {
      #loading-bar::after { animation: none; display: none; }
    }


    /* Zoom controls */
    .osd-controls {
      position: fixed;
      bottom: 1.2rem;
      right: 1.2rem;
      display: flex;
      flex-direction: column;
      gap: 4px;
      z-index: 50;
    }

    #btn-back {
      position: fixed;
      top: 1.2rem;
      left: 1.2rem;
      z-index: 50;
      text-decoration: none;
    }

    .osd-controls button, #btn-back {
      width: 36px;
      height: 36px;
      background: rgba(255,255,255,0.82);
      backdrop-filter: blur(3px);
      color: #000;
      border: 1px solid rgba(0,0,0,0.2);
      box-shadow: 0 2px 6px rgba(0,0,0,0.12);
      cursor: pointer;
      display: flex;
      align-items: center;
      justify-content: center;
    }

    .osd-controls button:hover, #btn-back:hover {
      background: rgba(255,255,255,0.97);
    }

    .osd-controls img, #btn-back img {
      width: 24px;
      height: 24px;
    }

    /* 48px touch targets on touchscreens */
    @media (pointer: coarse) {
      .osd-controls button, #btn-back {
        width: 48px;
        height: 48px;
      }

      .osd-controls img, #btn-back img {
        width: 32px;
        height: 32px;
      }
    }
  </style>
</head>
<body>
  <div id="loading">
    <Image id="loading-cover" src={wraparoundCover} width={600} quality={50} loading="eager" alt="SIGHORSE 2025 cover" />
    <div id="loading-bar-outer"><div id="loading-bar"></div></div>
  </div>

  <div id="viewer" data-columns={COLUMNS} data-total={TOTAL_PAGES}></div>

  <a id="btn-back" href="/" title="Back" aria-label="Back to SIGHORSE 2025"><img src="/2025-postlaunch/tango/edit-undo.svg" alt="" /></a>

  <div class="osd-controls">
    <button id="btn-zoom-in" title="Zoom in" aria-label="Zoom in"><img src="/2025-postlaunch/tango/list-add.svg" alt="" /></button>
    <button id="btn-home" title="Fit to screen" aria-label="Fit to screen"><img src="/2025-postlaunch/tango/view-fullscreen.svg" alt="" /></button>
    <button id="btn-zoom-out" title="Zoom out" aria-label="Zoom out"><img src="/2025-postlaunch/tango/list-remove.svg" alt="" /></button>
  </div>

  <script is:inline src="https://cdn.jsdelivr.net/npm/openseadragon@4.1/build/openseadragon/openseadragon.min.js"></script>
  <script is:inline>
    var COLUMNS = parseInt(document.getElementById('viewer').dataset.columns, 10);
    var TOTAL = parseInt(document.getElementById('viewer').dataset.total, 10);

    var PAGE_ASPECT = 1.414;
    var PAGE_W = 1;
    var PAGE_H = PAGE_W * PAGE_ASPECT;
    var GAP_X = 0.04;
    var GAP_Y = 0.05;

    var viewer = OpenSeadragon({
      id: 'viewer',
      prefixUrl: 'https://cdn.jsdelivr.net/npm/openseadragon@4.1/build/openseadragon/images/',
      showNavigationControl: false,
      showNavigator: false,
      animationTime: 0.4,
      blendTime: 0.1,
      constrainDuringPan: false,
      maxZoomPixelRatio: 4,
      minZoomImageRatio: 0.1,
      visibilityRatio: 0.05,
      zoomPerScroll: 1.3,
      gestureSettingsMouse: { clickToZoom: false },
      background: '#e0e0e0',
    });

    var loadingEl = document.getElementById('loading');
    var barEl = document.getElementById('loading-bar');
    var loaded = 0;

    function onLoad() {
      loaded++;
      var pct = Math.round((loaded / TOTAL) * 100);
      barEl.style.width = pct + '%';
      if (loaded === TOTAL) {
        setTimeout(function() {
          loadingEl.classList.add('fade-out');
          setTimeout(function() { loadingEl.remove(); }, 700);
        }, 200);
      }
    }

    for (var i = 0; i < TOTAL; i++) {
      var num = String(i + 1).padStart(3, '0');
      var url = '/2025-postlaunch/dzi/page-' + num + '.dzi';
      var col = i % COLUMNS;
      var row = Math.floor(i / COLUMNS);
      var x = col * (PAGE_W + GAP_X);
      var y = row * (PAGE_H + GAP_Y);

      viewer.addTiledImage({
        tileSource: url,
        x: x,
        y: y,
        width: PAGE_W,
        success: onLoad,
        error: onLoad,
      });
    }

    document.getElementById('btn-zoom-in').addEventListener('click', function() { viewer.viewport.zoomBy(1.5); });
    document.getElementById('btn-zoom-out').addEventListener('click', function() { viewer.viewport.zoomBy(1 / 1.5); });
    document.getElementById('btn-home').addEventListener('click', function() { viewer.viewport.goHome(); });
  </script>
</body>
</html>
