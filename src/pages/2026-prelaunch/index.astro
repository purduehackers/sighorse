---
import horseImg from '../../assets/2026-prelaunch/horse.png';
---
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
  <meta name="theme-color" content="#f0f0f0">
  <meta name="description" content="SIGHORSE&nbsp;2026 — Purdue Hackers">
  <meta property="og:title" content="SIGHORSE&nbsp;2026">
  <meta property="og:description" content="SIGHORSE (the Special Interest Group in Horsing Around) — 2026 edition, by Purdue Hackers.">
  <title>SIGHORSE&nbsp;2026</title>
  <style>
    *, *::before, *::after {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
    }

    html, body {
      width: 100%;
      height: 100%;
      overflow: hidden;
      background: #f0f0f0;
      touch-action: manipulation;
      font-family: 'Arial Black', Impact, system-ui, sans-serif;
    }

    body {
      display: flex;
      align-items: center;
      justify-content: center;
    }

    /* ── Prompt screen ── */
    #prompt-screen {
      position: fixed;
      inset: 0;
      display: flex;
      align-items: center;
      justify-content: center;
      z-index: 10;
      cursor: pointer;
      -webkit-tap-highlight-color: transparent;
      user-select: none;
      background: #f0f0f0;
    }

    #prompt-text {
      font-family: 'Arial Black', Impact, system-ui, sans-serif;
      font-weight: 950;
      color: #1a1a1a;
      text-align: center;
      text-transform: uppercase;
      letter-spacing: -0.08em;
      line-height: 0.78;
      transform: rotate(-4deg);
    }

    #prompt-text span {
      display: block;
      font-size: clamp(2rem, min(5vw, 10vh), 5rem);
    }

    #prompt-text strong {
      display: block;
      font-size: clamp(3.6rem, min(9vw, 18vh), 9rem);
    }

    /* ── Scene: horse + panels ── */
    #scene {
      position: relative;
      width: min(92vw, 88vh);
      height: min(92vw, 88vh);
      display: flex;
      align-items: center;
      justify-content: center;
      overflow: visible;
    }

    /* ── Speed streaks ── */
    #streaks {
      position: absolute;
      inset: 0;
      pointer-events: none;
      z-index: 1;
      overflow: visible;
    }

    .streak {
      position: absolute;
      top: 50%;
      left: 50%;
      height: 2px;
      border-radius: 1px;
      opacity: 0;
    }

    /* ── Horse ── */
    #horse {
      position: relative;
      z-index: 10;
      width: min(58vw, 58vh);
      max-width: 520px;
      height: auto;
      display: block;
      opacity: 0;
      pointer-events: none;
    }

    /* ── Menu panels ── */
    .panel {
      position: fixed;
      display: flex;
      align-items: center;
      font-family: 'Arial Black', Impact, system-ui, sans-serif;
      font-weight: 900;
      font-size: clamp(1rem, 3.5vmin, 2.6rem);
      text-transform: uppercase;
      letter-spacing: 0.03em;
      color: #111;
      text-decoration: none;
      opacity: 0;
      left: 0;
      top: 0;
      filter: drop-shadow(20px 20px 0 #000);
      transition: filter 0.12s ease;
      height: auto;
    }

    .panel:hover {
      filter: drop-shadow(22px 22px 0 #000) brightness(0.88);
    }

    .panel:focus-visible {
      outline: 3px solid #333;
      outline-offset: 6px;
    }

    .panel-inner {
      display: block;
      width: 100%;
      clip-path: polygon(8% 0%, 100% 0%, 92% 100%, 0% 100%);
      padding: 0.4em 1.6em 0.4em 2.2em;
      box-sizing: border-box;
      line-height: 1.1;
      word-break: break-word;
      min-height: clamp(40px, 8vmin, 80px);
    }

    #panel-title   { z-index: 9; }
    #panel-2025    { z-index: 7; }
    #panel-discord { z-index: 6; }
    #panel-purdue  { z-index: 5; }
    #panel-title   .panel-inner { background: #9ecfc4; }
    #panel-2025    .panel-inner { background: #bebebe; }
    #panel-discord .panel-inner { background: #b8c4e0; }
    #panel-purdue  .panel-inner { background: #d4c8b0; }

    /* ── Mobile list layout ── */
    #mobile-scene {
      display: none;
      flex-direction: column;
      align-items: stretch;
      gap: 10px;
      width: min(480px, 90vw);
      max-height: 100svh;
      overflow-y: auto;
      padding: 20px 16px;
      scrollbar-width: none;
    }

    #mobile-scene::-webkit-scrollbar { display: none; }

    .mobile-panel {
      display: flex;
      align-items: center;
      font-family: 'Arial Black', Impact, system-ui, sans-serif;
      font-weight: 900;
      font-size: clamp(0.9rem, 4vmin, 1.8rem);
      text-transform: uppercase;
      letter-spacing: 0.03em;
      color: #111;
      text-decoration: none;
      filter: drop-shadow(8px 8px 0 #000);
      transition: filter 0.12s ease;
    }

    .mobile-panel:hover {
      filter: drop-shadow(10px 10px 0 #000) brightness(0.88);
    }

    .mobile-panel-inner {
      display: flex;
      align-items: center;
      width: 100%;
      clip-path: polygon(4% 0%, 100% 0%, 96% 100%, 0% 100%);
      padding: 0.5em 2em 0.5em 1.6em;
      min-height: clamp(44px, 9vmin, 68px);
      line-height: 1.1;
    }

    #mobile-horse-wrap {
      display: flex;
      justify-content: center;
      padding: 4px 0;
    }

    #mobile-horse {
      width: min(55vw, 220px);
      height: auto;
      display: block;
    }

    /* At ≤1000px width OR ≤400px height: hide desktop scene */
    @media (max-width: 1000px), (max-height: 400px) {
      #scene { display: none !important; }
    }

  </style>
</head>
<body>

  <!-- Prompt screen: tap / click anywhere to begin -->
  <div id="prompt-screen" role="button" tabindex="0" aria-label="Tap to summon the horse">
    <p id="prompt-text"><span>Tap to summon</span><strong>the horse</strong></p>
  </div>

  <!-- Desktop scene: speed streaks + horse + menu panels -->
  <div id="scene" aria-live="polite">

    <div id="streaks"></div>

    <img id="horse" src={horseImg.src} alt="The SIGHORSE&nbsp;2026 horse" />

    <a href="https://blog.purduehackers.com/posts/sighorse" class="panel" id="panel-title">
      <span class="panel-inner">LEARN ABOUT<br><span style="white-space: nowrap;">SIGHORSE&nbsp;2025</span></span>
    </a>
    <a href="/2025-postlaunch/" class="panel" id="panel-2025">
      <span class="panel-inner">Read the 2025 Edition</span>
    </a>
    <a href="https://discord.gg/5paFjKzdPE" class="panel" id="panel-discord">
      <span class="panel-inner">JOIN <br><span style="white-space: nowrap;">SIGHORSE<br>2026</span></span>
    </a>
    <a href="https://www.purduehackers.com/" class="panel" id="panel-purdue">
      <span class="panel-inner">Run by Purdue Hackers</span>
    </a>

  </div>

  <!-- Mobile list layout (shown after summon at narrow/short viewports) -->
  <div id="mobile-scene" aria-live="polite">
    <a href="https://blog.purduehackers.com/posts/sighorse" class="mobile-panel">
      <span class="mobile-panel-inner" style="background:#9ecfc4;">LEARN ABOUT<br>SIGHORSE&nbsp;2025</span>
    </a>
    <a href="/2025-postlaunch/" class="mobile-panel">
      <span class="mobile-panel-inner" style="background:#bebebe;">Read the 2025 Edition</span>
    </a>
    <div id="mobile-horse-wrap">
      <img id="mobile-horse" src={horseImg.src} alt="The SIGHORSE&nbsp;2026 horse" />
    </div>
    <a href="https://discord.gg/5paFjKzdPE" class="mobile-panel">
      <span class="mobile-panel-inner" style="background:#b8c4e0;">JOIN<br>SIGHORSE<br>2026</span>
    </a>
    <a href="https://www.purduehackers.com/" class="mobile-panel">
      <span class="mobile-panel-inner" style="background:#d4c8b0;">Run by Purdue Hackers</span>
    </a>
  </div>

  <script>
    import gsap from 'gsap';

    function isMobileLayout(): boolean {
      return window.innerWidth <= 1000 || window.innerHeight <= 400;
    }

    // ── Build speed streaks ──
    const streaksEl = document.getElementById('streaks')!;
    const STREAK_COUNT = 12;
    const STREAK_WIDTHS = [46, 38, 52, 41, 35, 49, 44, 37, 55, 40, 47, 34];
    for (let i = 0; i < STREAK_COUNT; i++) {
      const el = document.createElement('div');
      el.className = 'streak';
      const angle = i * (360 / STREAK_COUNT);
      const width = STREAK_WIDTHS[i] ?? 42;
      el.style.cssText = [
        `width: ${width}%`,
        `transform: rotate(${angle}deg)`,
        `background: linear-gradient(to right, transparent 0%, rgba(20,20,20,0.28) 55%, transparent 100%)`,
      ].join(';');
      streaksEl.appendChild(el);
    }

    // ── Set initial GSAP states ──
    gsap.set('#horse', {
      scale: 0.3,
      opacity: 0,
      transformOrigin: 'center center',
    });

    gsap.set('.streak', {
      scaleX: 0,
      opacity: 0,
      transformOrigin: 'left center',
    });

    const horseEl = document.getElementById('horse')!;

    const PANEL_IDS = ['panel-discord', 'panel-title', 'panel-2025', 'panel-purdue'];
    const PANEL_ANGLES_DEG = [-150, 150, -30, 30];
    const PANEL_INSETS_PX  = [155, 100, 40, 40];
    const SCREEN_MARGIN = 20;
    const MAX_PANEL_LENGTHS = [400, 430, 380, 380];

    function placePanels(animate: boolean) {
      const horseRect = horseEl.getBoundingClientRect();
      const horseCx = horseRect.left + horseRect.width  / 2;
      const horseCy = horseRect.top  + horseRect.height / 2;
      const horseRx = horseEl.offsetWidth  / 2;
      const horseRy = horseEl.offsetHeight / 2;
      const W = window.innerWidth;
      const H = window.innerHeight;

      PANEL_IDS.forEach((id, i) => {
        const panel    = document.getElementById(id)!;
        const angleDeg = PANEL_ANGLES_DEG[i];
        const angleRad = angleDeg * Math.PI / 180;
        const cosA     = Math.cos(angleRad);
        const sinA     = Math.sin(angleRad);

        const hr = (horseRx * horseRy) /
          Math.sqrt((horseRy * cosA) ** 2 + (horseRx * sinA) ** 2);

        const innerDist = hr - PANEL_INSETS_PX[i];

        const txMax = cosA > 0 ? (W - horseCx) / cosA : cosA < 0 ? horseCx / -cosA : Infinity;
        const tyMax = sinA > 0 ? (H - horseCy) / sinA : sinA < 0 ? horseCy / -sinA : Infinity;
        const outerDist = Math.min(txMax, tyMax) - SCREEN_MARGIN;

        const panelLength = Math.min(Math.max(outerDist - innerDist, 40), MAX_PANEL_LENGTHS[i]);

        const panelCenterDist = innerDist + panelLength / 2;
        const targetX = horseCx + cosA * panelCenterDist;
        const targetY = horseCy + sinA * panelCenterDist;

        panel.style.width = `${panelLength}px`;

        let rotDeg = angleDeg;
        if (rotDeg >  90) rotDeg -= 180;
        if (rotDeg < -90) rotDeg += 180;

        if (animate) {
          gsap.set(panel, { x: targetX, y: targetY, rotation: rotDeg });
        } else {
          gsap.set(panel, {
            x: horseCx, y: horseCy,
            xPercent: -50, yPercent: -50,
            scale: 0, opacity: 0,
            rotation: rotDeg,
            transformOrigin: 'center center',
          });
        }

        panel.dataset.tx = String(targetX);
        panel.dataset.ty = String(targetY);
      });
    }

    placePanels(false);

    // ── Animation sequence ──
    let triggered = false;

    function summon() {
      if (triggered) return;
      triggered = true;

      const tl = gsap.timeline();

      tl.to('#prompt-screen', {
        opacity: 0,
        duration: 0.28,
        ease: 'power2.in',
      }).set('#prompt-screen', { display: 'none' })
        .addLabel('start');

      if (isMobileLayout()) {
        // Mobile: same zoom-in as desktop horse, then panels slide in
        const mobileScene = document.getElementById('mobile-scene')!;
        mobileScene.style.display = 'flex';
        gsap.set('#mobile-horse', { scale: 0.3, opacity: 0, transformOrigin: 'center center' });
        gsap.set('.mobile-panel', { x: -24, opacity: 0 });

        tl.to('#mobile-horse', {
          scale: 1,
          opacity: 1,
          duration: 3.0,
          ease: 'power2.in',
        }, 'start');

        tl.to('.mobile-panel', {
          x: 0,
          opacity: 1,
          duration: 0.3,
          ease: 'back.out(1.4)',
          stagger: 0.09,
        }, 'start+=3.08');
      } else {
        // Desktop: horse + streak + panel animation
        tl.to('#horse', {
          scale: 1,
          opacity: 1,
          duration: 3.0,
          ease: 'power2.in',
        }, 'start');
        tl.addLabel('arrived', 'start+=3.0');

        tl.to('.streak', {
          scaleX: 1,
          opacity: 0.6,
          duration: 0.18,
          ease: 'power3.out',
          stagger: { each: 0.012, from: 'random' },
        }, 'arrived-=0.65')
          .to('.streak', {
            scaleX: 0.1,
            opacity: 0,
            duration: 0.3,
            ease: 'power2.in',
            stagger: { each: 0.01, from: 'random' },
          }, '>-0.05');

        PANEL_IDS.forEach((id, i) => {
          const panel = document.getElementById(id)!;
          tl.to(panel, {
            x: parseFloat(panel.dataset.tx!),
            y: parseFloat(panel.dataset.ty!),
            scale: 1,
            opacity: 1,
            duration: 0.38,
            ease: 'back.out(1.5)',
          }, i === 0 ? 'arrived+=0.08' : '>-0.10');
        });
      }
    }

    const promptEl = document.getElementById('prompt-screen')!;
    promptEl.addEventListener('click', summon);
    promptEl.addEventListener('keydown', (e: KeyboardEvent) => {
      if (e.key === 'Enter' || e.key === ' ') {
        e.preventDefault();
        summon();
      }
    });

    const mobileSceneEl = document.getElementById('mobile-scene')!;

    function syncLayout() {
      if (!triggered) {
        placePanels(false);
        return;
      }

      const mobile = isMobileLayout();

      if (mobile) {
        mobileSceneEl.style.display = 'flex';
        gsap.set('#mobile-horse', { scale: 1, opacity: 1 });
        gsap.set('.mobile-panel', { x: 0, opacity: 1 });
      } else {
        // Switch to desktop: hide mobile scene, re-place and reveal desktop panels
        mobileSceneEl.style.display = 'none';
        placePanels(true);
        PANEL_IDS.forEach(id => {
          gsap.set(document.getElementById(id)!, { opacity: 1, scale: 1 });
        });
        gsap.set('#horse', { opacity: 1, scale: 1 });
      }
    }

    new ResizeObserver(syncLayout).observe(document.documentElement);
  </script>

</body>
</html>
