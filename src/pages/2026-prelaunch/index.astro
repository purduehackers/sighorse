---
import horseImg from '../../assets/2026-prelaunch/horse.png';
---
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
  <meta name="theme-color" content="#f0f0f0">
  <meta name="description" content="SIGHORSE&nbsp;2026 — Purdue Hackers">
  <meta property="og:title" content="SIGHORSE&nbsp;2026">
  <meta property="og:description" content="SIGHORSE (the Special Interest Group in Horsing Around) — 2026 edition, by Purdue Hackers.">
  <title>SIGHORSE&nbsp;2026</title>
  <style>
    *, *::before, *::after {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
    }

    html, body {
      width: 100%;
      height: 100%;
      overflow: hidden;
      background: #f0f0f0;
      touch-action: manipulation;
      font-family: 'Arial Black', Impact, system-ui, sans-serif;
    }

    body {
      display: flex;
      align-items: center;
      justify-content: center;
    }

    /* ── Prompt screen ── */
    #prompt-screen {
      position: fixed;
      inset: 0;
      display: flex;
      align-items: center;
      justify-content: center;
      z-index: 10;
      cursor: pointer;
      -webkit-tap-highlight-color: transparent;
      user-select: none;
      background: #f0f0f0;
    }

    #prompt-text {
      font-family: 'Arial Black', Impact, system-ui, sans-serif;
      font-weight: 950;
      color: #1a1a1a;
      text-align: center;
      text-transform: uppercase;
      letter-spacing: -0.08em;
      line-height: 0.78;
      transform: rotate(-4deg);
    }

    #prompt-text span {
      display: block;
      font-size: clamp(2rem, min(5vw, 10vh), 5rem);
    }

    #prompt-text strong {
      display: block;
      font-size: clamp(3.6rem, min(9vw, 18vh), 9rem);
    }


    /* ── Mobile list layout ── */
    #mobile-scene {
      display: none;
      flex-direction: column;
      align-items: stretch;
      gap: 10px;
      width: min(480px, 90vw);
      max-height: 100svh;
      overflow-y: auto;
      padding: 20px 16px;
      scrollbar-width: none;
    }

    #mobile-scene::-webkit-scrollbar { display: none; }

    .mobile-panel {
      display: flex;
      align-items: center;
      font-family: 'Arial Black', Impact, system-ui, sans-serif;
      font-weight: 900;
      font-size: clamp(0.9rem, 4vmin, 1.8rem);
      text-transform: uppercase;
      letter-spacing: 0.03em;
      color: #111;
      text-decoration: none;
      filter: drop-shadow(8px 8px 0 #000);
      transition: filter 0.12s ease;
    }

    .mobile-panel:hover {
      filter: drop-shadow(10px 10px 0 #000) brightness(0.88);
    }

    .mobile-panel-inner {
      display: flex;
      align-items: center;
      width: 100%;
      clip-path: polygon(4% 0%, 100% 0%, 96% 100%, 0% 100%);
      padding: 0.5em 2em 0.5em 1.6em;
      min-height: clamp(44px, 9vmin, 68px);
      line-height: 1.1;
    }

    #mobile-horse-wrap {
      display: flex;
      justify-content: center;
      padding: 4px 0;
    }

    #mobile-horse {
      width: min(55vw, 220px);
      height: auto;
      display: block;
    }


  </style>
</head>
<body>

  <!-- Prompt screen: tap / click anywhere to begin -->
  <div id="prompt-screen" role="button" tabindex="0" aria-label="Tap to summon the horse">
    <p id="prompt-text"><span>Tap to summon</span><strong>the horse</strong></p>
  </div>


  <!-- Mobile list layout (shown after summon at narrow/short viewports) -->
  <div id="mobile-scene" aria-live="polite">
    <a href="https://blog.purduehackers.com/posts/sighorse" class="mobile-panel">
      <span class="mobile-panel-inner" style="background:#9ecfc4;">LEARN ABOUT<br>SIGHORSE&nbsp;2025</span>
    </a>
    <a href="/2025-postlaunch/" class="mobile-panel">
      <span class="mobile-panel-inner" style="background:#bebebe;">Read the 2025 Edition</span>
    </a>
    <div id="mobile-horse-wrap">
      <img id="mobile-horse" src={horseImg.src} alt="The SIGHORSE&nbsp;2026 horse" />
    </div>
    <a href="https://discord.gg/5paFjKzdPE" class="mobile-panel">
      <span class="mobile-panel-inner" style="background:#b8c4e0;">JOIN<br>SIGHORSE<br>2026</span>
    </a>
    <a href="https://www.purduehackers.com/" class="mobile-panel">
      <span class="mobile-panel-inner" style="background:#d4c8b0;">Run by Purdue Hackers</span>
    </a>
  </div>

  <script>
    import gsap from 'gsap';

    let triggered = false;

    function summon() {
      if (triggered) return;
      triggered = true;

      const tl = gsap.timeline();
      const mobileScene = document.getElementById('mobile-scene')!;

      tl.to('#prompt-screen', {
        opacity: 0,
        duration: 0.28,
        ease: 'power2.in',
      }).set('#prompt-screen', { display: 'none' })
        .set(mobileScene, { display: 'flex' }, 0)
        .set('#mobile-horse', { scale: 0.3, opacity: 0, transformOrigin: 'center center' }, 0)
        .set('.mobile-panel', { x: -24, opacity: 0 }, 0)
        .to('#mobile-horse', {
          scale: 1,
          opacity: 1,
          duration: 3.0,
          ease: 'power2.in',
        }, 0)
        .to('.mobile-panel', {
          x: 0,
          opacity: 1,
          duration: 0.3,
          ease: 'back.out(1.4)',
          stagger: 0.09,
        }, '>');
    }

    const promptEl = document.getElementById('prompt-screen')!;
    promptEl.addEventListener('click', summon);
    promptEl.addEventListener('keydown', (e: KeyboardEvent) => {
      if (e.key === 'Enter' || e.key === ' ') {
        e.preventDefault();
        summon();
      }
    });
  </script>

</body>
</html>
