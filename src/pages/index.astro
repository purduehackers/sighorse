---
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';

import page112 from '../assets/scattered-pages/page_112.jpg';
import page117 from '../assets/scattered-pages/page_117.jpg';
import page123 from '../assets/scattered-pages/page_123.jpg';
import page125 from '../assets/scattered-pages/page_125.jpg';
import page133 from '../assets/scattered-pages/page_133.jpg';
import page145 from '../assets/scattered-pages/page_145.jpg';
import page166 from '../assets/scattered-pages/page_166.jpg';
import page17 from '../assets/scattered-pages/page_17.jpg';
import page18 from '../assets/scattered-pages/page_18.jpg';
import page2 from '../assets/scattered-pages/page_2.jpg';
import page218 from '../assets/scattered-pages/page_218.jpg';
import page23 from '../assets/scattered-pages/page_23.jpg';
import page24 from '../assets/scattered-pages/page_24.jpg';
import page257 from '../assets/scattered-pages/page_257.jpg';
import page270 from '../assets/scattered-pages/page_270.jpg';
import page277 from '../assets/scattered-pages/page_277.jpg';
import page43 from '../assets/scattered-pages/page_43.jpg';
import page59 from '../assets/scattered-pages/page_59.jpg';
import page63 from '../assets/scattered-pages/page_63.jpg';
import page69 from '../assets/scattered-pages/page_69.jpg';
import page73 from '../assets/scattered-pages/page_73.jpg';
import page79 from '../assets/scattered-pages/page_79.jpg';
import page8 from '../assets/scattered-pages/page_8.jpg';
import page84 from '../assets/scattered-pages/page_84.jpg';

import sighorseSide from '../assets/sighorse-side.jpg';
import sighorseTable from '../assets/sighorse-table.webp';

const scatterSet1 = [
  { src: page112, alt: 'page 112', variant: 's-v1' },
  { src: page123, alt: 'page 123', variant: 's-v2' },
  { src: page145, alt: 'page 145', variant: 's-v3' },
  { src: page218, alt: 'page 218', variant: 's-v4' },
  { src: page270, alt: 'page 270', variant: 's-v1' },
  { src: page43, alt: 'page 43', variant: 's-v2' },
  { src: page23, alt: 'page 23', variant: 's-v3' },
  { src: page24, alt: 'page 24', variant: 's-v4' },
  { src: page277, alt: 'page 277', variant: 's-v1' },
  { src: page59, alt: 'page 59', variant: 's-v2' },
  { src: page84, alt: 'page 84', variant: 's-v3' },
  { src: page69, alt: 'page 69', variant: 's-v4' },
  { src: page63, alt: 'page 63', variant: 's-v1' },
  { src: page73, alt: 'page 73', variant: 's-v2' },
  { src: page79, alt: 'page 79', variant: 's-v3' },
  { src: page117, alt: 'page 117', variant: 's-v4' },
  { src: page125, alt: 'page 125', variant: 's-v1' },
  { src: page133, alt: 'page 133', variant: 's-v2' },
  { src: page166, alt: 'page 166', variant: 's-v3' },
  { src: page257, alt: 'page 257', variant: 's-v4' },
  { src: page8, alt: 'page 8', variant: 's-v1' },
  { src: page2, alt: 'page 2', variant: 's-v2' },
  { src: page18, alt: 'page 18', variant: 's-v3' },
  { src: page17, alt: 'page 17', variant: 's-v4' },
];

const scatterSet2 = [
  { src: page112, alt: 'page 112', variant: 's-v1' },
  { src: page123, alt: 'page 123', variant: 's-v2' },
  { src: page145, alt: 'page 145', variant: 's-v3' },
  { src: page218, alt: 'page 218', variant: 's-v4' },
  { src: page270, alt: 'page 270', variant: 's-v1' },
  { src: page43, alt: 'page 43', variant: 's-v2' },
  { src: page23, alt: 'page 23', variant: 's-v3' },
  { src: page24, alt: 'page 24', variant: 's-v4' },
  { src: page277, alt: 'page 277', variant: 's-v1' },
  { src: page59, alt: 'page 59', variant: 's-v2' },
  { src: page84, alt: 'page 84', variant: 's-v3' },
  { src: page69, alt: 'page 69', variant: 's-v4' },
  { src: page63, alt: 'page 63', variant: 's-v1' },
  { src: page73, alt: 'page 73', variant: 's-v2' },
  { src: page79, alt: 'page 79', variant: 's-v3' },
  { src: page117, alt: 'page 117', variant: 's-v4' },
];

const scatterSet3 = scatterSet1;
const scatterSet4 = scatterSet1.slice(0, 21);

const allScatters = [...scatterSet1, ...scatterSet2, ...scatterSet3, ...scatterSet4];
---

<BaseLayout title="SIGHORSE: The Special Interest Group in HORSEing around">
  <!-- Scattered background grid -->
  <div class="scattered-bg">
    {allScatters.map((item) => (
      <Image src={item.src} class={`scatter ${item.variant}`} alt={item.alt} />
    ))}
  </div>

  <!-- Dim layer -->
  <div class="dim-layer"></div>

  <!-- Content wrapper -->
  <div class="spread-wrapper">
    <!-- Title Page -->
    <section class="page-card">
      <header>
        <div><a href="https://purduehackers.com" style="color: #0066cc;">Purdue Hackers</a></div>
        <br />
        <div class="indent-1">presents</div>
        <br />
        <div class="indent-2">
          a journal of things done over summer 2025
          <div class="greyed" style="font-size: 1em;">(and sometimes the fall, but we don't talk about that timeline overrun)</div>
        </div>
      </header>

      <div class="title-group">
        <div class="title">SIGHORSE 2025 🦓</div>
        <a href="/book.pdf" class="marquee-btn">
          <div class="marquee-track">
            <span>READ THE JOURNAL (PDF) | READ THE JOURNAL (PDF) | READ THE JOURNAL (PDF) |&nbsp;</span>
            <span>READ THE JOURNAL (PDF) | READ THE JOURNAL (PDF) | READ THE JOURNAL (PDF) |&nbsp;</span>
          </div>
        </a>

        <br />
        <div>many authors</div>
        <br />
        <div style="font-size: 0.85rem;">
          cover art by Cynthia, Amber, and Kart<br />
          illustrations by Amber and authors
        </div>
        <br />
        <div>
          purdue university<br />
          west lafayette, indiana
        </div>
        <br />
        <div>
          first presented on December 6, 2025<br />
          at <a href="https://spill.purduehackers.com" style="color: #0066cc;">SPILL</a>
        </div>
      </div>

      <footer>
        <div class="greyed" style="font-size: 0.9rem; text-align: center; margin-bottom: 1em;">
          <div>thank you, <a href="https://sigbovik.org/" target="_blank" style="color: #0066cc;">sigbovik</a>, for existing so I could copy the title page and copyright page style off you.</div>
          <br />
          <a href="/old.html" style="color: #0066cc;">click here for the old sighorse website</a>
        </div>
        <br />
        <div style="text-align: left;">
          2
        </div>
      </footer>
    </section>

    <!-- Paper Copy Page -->
    <section class="page-card">
      <div class="title-group" style="margin-bottom: 1.5em;">
        <div class="title">BUY A PAPER COPY</div>
      </div>
      <div style="flex: 1; overflow-y: auto;">
        <div>
          <div style="font-size: 1rem;">
            Due to popular demand, SIGHORSE had a limited print run. 63 orders were received.
            Book details:
            <ul style="margin-left: 1.5em; margin-top: 0.5em;">
              <li>A5, perfect bound, 80lb matte coated paper.</li>
              <li>307 pages, out of which 189 are colored.</li>
              <li>Contains the substring "horse" at least 46 times.</li>
            </ul>
          </div>

          <div style="margin-top: 1.5em;">
            <strong>FAQ:</strong>
            <ul style="margin-left: 1.5em; margin-top: 0.5em; font-size: 1rem;">
              <li style="margin-bottom: 0.8em;">
                <strong>Is the print edition different from the online edition?</strong><br />
                No. The print edition is identical to the online PDF.
              </li>
              <li style="margin-bottom: 0.8em;">
                <strong>When will I be able to get the books?</strong><br />
                Around the first week of February.
              </li>
              <li style="margin-bottom: 0.8em;">
                <strong>How will I receive the book?</strong><br />
                Come to any <a href="https://events.purduehackers.com/" style="color: #0066cc;">Hack Night</a>. You can request shipping (provided you pay) in your donation message or <a href="mailto:phackers@purdue.edu" style="color: #0066cc;">by emailing us</a>, and we can figure it out from there.
              </li>
            </ul>
          </div>

          <div style="margin-top: 1.5em; font-size: 0.95rem; overflow-wrap: break-word;">
            To register interest in a future printing run, <a href="mailto:phackers@purdue.edu?subject=Please print SIGHORSE again" style="color: #0066cc; word-break: break-all;">email us</a>. <br /><br />
            <strong>If you enjoyed this work, <a href="https://phack.rs/donate-hcb" data-umami-event="donate-link-click" style="color: #0066cc;">please donate to Purdue Hackers so we can run this again!</a></strong> <br />
          </div>

          <div class="image-container" style="margin-top: 1.5em;">
            <Image src={sighorseSide} alt="SIGHORSE book side view" />
            <Image src={sighorseTable} alt="SIGHORSE books on table" />
          </div>
        </div>
      </div>

      <footer style="margin-top: auto;">
        <div style="text-align: left;">
          3
        </div>
      </footer>
    </section>
  </div>
</BaseLayout>
